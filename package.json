{
  "name": "rest-safe-env",
  "description": "Encrypt selected .env values at rest and unlock only with explicit local approval.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adpopescu338/rest-safe-env.git"
  },
  "homepage": "https://github.com/adpopescu338/rest-safe-env",
  "bugs": {
    "url": "https://github.com/adpopescu338/rest-safe-env/issues"
  },
  "bin": {
    "rse": "bin/rse.js"
  },
  "author": {
    "name": "Alexandru-Daniel Popescu",
    "email": "ad.popescu338@yahoo.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --mode cli",
    "prepack": "yarn build",
    "link-rse": "yarn build && npm link",
    "relink-rse": "yarn build && npm unlink -g rest-safe-env && npm link",
    "lint": "eslint .",
    "test:parser": "node --test tests/parser-roundtrip.test.mjs",
    "demo-tsx": "vite build --mode cli && node dist/cli.js run demo/.env -- npx tsx demo/demo.ts",
    "demo-node": "vite build --mode cli && node dist/cli.js run demo/.env -- node demo/demo.js",
    "brew:formula": "node scripts/generate-homebrew-formula.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "resolutions": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
